# Locale for console messages: EN or RU
APP_LOCALE=EN

SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback

# Optional. If set, the app validates the proxy at startup and uses it when available. Example: http://login:password@123.123.123.123:8000
SPOTIFY_PROXY_URL=

SAVED_RECENT_WINDOWS=50,200
SAVED_IN_YEAR_YEARS=2024,2025
# Optional. Merged playlists: "Target=Source1+Source2" entries separated by ";".
# Sources are looked up by exact name; tracks are merged, sorted by added date (newest first) and deduplicated.
# Prefix the target with "sortBySaved:" to order that playlist like your saved tracks instead
# (newest saves first; tracks missing from saved tracks go to the end by source added date).
# The merged playlist is updated together with year playlists (AUTO_PLAYLISTS_RARE_SYNC_INTERVAL_MS).
AUTO_PLAYLISTS_MERGED_PLAYLISTS=
# Optional. Top-of-playlist auto playlists: "Source:50,100" entries separated by ";".
# For every source and window an auto playlist is created and maintained, named "Source 50 [AUTO]".
# Tracks are taken from the top of the source playlist in its current order and deduplicated.
# Source names must not contain ";" or ":".
AUTO_PLAYLISTS_RECENT_FROM_PLAYLISTS=
# Optional. Name of the exclude playlist. Tracks from this playlist are skipped when
# building the recent auto playlists (recently saved and top-of-playlist). Use it to keep
# re-added old tracks out of the recent lists. Looked up by exact name; if the playlist
# is missing, exclusions are skipped until the next sync.
EXCLUDE_PLAYLIST_TITLE=
TRACK_MONITORING_ENABLED=true

AUTO_PLAYLISTS_PLAYLIST_PREFIX=
AUTO_PLAYLISTS_PLAYLIST_SUFFIX=[AUTO]
SAVED_RECENT_COVER_COLOR=000000
SAVED_IN_YEAR_COVER_COLOR=060E73
# Default: 14532D (dark green)
RECENT_FROM_PLAYLISTS_COVER_COLOR=14532D

# Default: 600000 (10 minutes)
AUTO_PLAYLISTS_FREQUENT_SYNC_INTERVAL_MS=600000
# Default: 10800000 (3 hours)
AUTO_PLAYLISTS_RARE_SYNC_INTERVAL_MS=10800000
# Default: 60000 (1 minute). Mandatory pause between sync cycles in the shared queue.
AUTO_PLAYLISTS_SYNC_QUEUE_GAP_MS=60000
# Default: 5000 (5 seconds)
POLL_INTERVAL_MS=5000
# Default: 100 (0.1 seconds)
SPOTIFY_MIN_REQUEST_GAP_MS=500





